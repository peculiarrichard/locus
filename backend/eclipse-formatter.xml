<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- Overrides Spotless's Eclipse-formatter defaults to actually match checkstyle.xml's 120-char limit and space indentation, so the two tools stop disagreeing. -->
<profiles version="1">
  <profile kind="CodeFormatterProfile" name="locus" version="1">
    <setting id="org.eclipse.jdt.core.formatter.tabulation.char" value="space"/>
    <setting id="org.eclipse.jdt.core.formatter.tabulation.size" value="2"/>
    <setting id="org.eclipse.jdt.core.formatter.indentation.size" value="2"/>
    <setting id="org.eclipse.jdt.core.formatter.lineSplit" value="120"/>
    <setting id="org.eclipse.jdt.core.formatter.comment.line_length" value="120"/>
    <setting id="org.eclipse.jdt.core.formatter.join_wrapped_lines" value="false"/>
  </profile>
</profiles>
