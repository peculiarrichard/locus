<?xml version="1.0" encoding="UTF-8"?>
<!-- Structured JSON logging per technical-spec.md §10 — every line carries correlationId via MDC once request tracing is wired in. -->
<configuration>
  <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <includeMdcKeyName>correlationId</includeMdcKeyName>
      <customFields>{"service":"analytics-service"}</customFields>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="JSON"/>
  </root>
</configuration>
